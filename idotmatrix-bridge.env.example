# Required for reliable control. Set this after running `bridge.py discover`
# while the display is powered and visible.
IDOTMATRIX_ADDRESS=

# Choose 16x16, 32x32, or 64x64. This is required by the client API even
# though the on/off commands themselves do not use image dimensions.
IDOTMATRIX_SIZE=64x64
IDOTMATRIX_CLOCK_STYLE=7
IDOTMATRIX_LOG_LEVEL=INFO
